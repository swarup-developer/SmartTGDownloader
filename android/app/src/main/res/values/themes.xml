<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-first app: the launch window background matches the Compose dark
         background so there is no white flash, and edge-to-edge starts with
         transparent bars before Compose takes over. -->
    <style name="Theme.SmartTGDownloader" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
